# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# PRODUCTION (VPS): PostgreSQL 17 runs as the `db` service in
# docker-compose.prod.yml on the same VPS. Use the SERVICE NAME as the host —
# the app reaches it over the container network, and the database publishes no
# port to the host at all. The credentials must match POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB below.
#
#   DATABASE_URL="postgresql://wbos:CHANGE-ME@db:5432/wbos?schema=public"
#
# DEVELOPMENT: point at whatever you run locally — e.g. the homelab PostgreSQL.
# This is only a dev dependency; production does not touch the homelab.
DATABASE_URL="postgresql://wbos:changeme@192.168.100.36:5432/wbos?schema=public"

# Better Auth secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="change-me-to-a-random-secret"

# Production also requires BETTER_AUTH_URL to match the public HTTPS URL.

# ── Optional ────────────────────────────────────────────────────────────────

# Application URL (used for origin validation, cookie domain, and callback URLs)
# Must match the public URL users access in the browser.
#
# ⚠ PRODUCTION: this MUST be the https:// URL served by Caddy. Better Auth marks
# the session cookie `Secure` only when this is https, so leaving it as http
# silently ships a non-Secure session cookie.
#   BETTER_AUTH_URL="https://wbos.example.com"
BETTER_AUTH_URL="http://localhost:3000"

# Additional trusted origins for Better Auth (comma-separated)
# Useful in development or when behind a reverse proxy.
# Example: BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://192.168.100.36:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# CSRF / Origin validation on /api/auth/* (see docs/CSRF_DECISION.md).
#   unset (default) — validation DISABLED (historical behavior)
#   "0"             — validation ENABLED  ← set this in production
#
# Requires BETTER_AUTH_TRUSTED_ORIGINS to list every browser origin, or sign-in
# returns 403 INVALID_ORIGIN; startup validation fails fast on that combination.
#
# Verified end-to-end behind the Caddy proxy: web sign-up/sign-in succeed from
# the trusted origin, a cross-origin sign-in is rejected with 403, and MOBILE
# BEARER AUTH still works (it sends no cookie, so the origin check skips it) —
# which was the original reason the flag was turned on. Roll back by removing
# this line; no rebuild required.
#
# In DEVELOPMENT this also applies: if you open the app on a LAN address or a
# tunnel hostname, add that origin to BETTER_AUTH_TRUSTED_ORIGINS above or
# sign-in will 403. The server log names the rejected origin.
BETTER_AUTH_DISABLE_CSRF="0"

# ── Reverse proxy / TLS (production) ────────────────────────────────────────
#
# Public hostname served by Caddy. Required by docker-compose.prod.yml — the
# Caddyfile never hardcodes a domain. DNS for this name must point at the app
# host, and ports 80 + 443 must be reachable for certificate issuance.
# WBOS_DOMAIN="wbos.example.com"
#
# TLS mode:
#   an email address -> Let's Encrypt (ACME); the address gets expiry notices
#   "internal"       -> Caddy's local CA; self-signed, for LAN/offline/rehearsal
# Defaults to "internal" so a misconfigured domain fails to a self-signed cert
# instead of burning Let's Encrypt rate limits on a name that does not resolve.
# WBOS_TLS="ops@example.com"
#
# Caddy image override (pin a digest if you want reproducible proxy builds).
# CADDY_IMAGE="caddy:2-alpine"

# ── Client IP / trusted proxies ─────────────────────────────────────────────
#
# Number of TRUSTED reverse proxies in front of the app. Per-IP rate limiting
# reads the client address this many hops from the RIGHT of X-Forwarded-For,
# because everything to the left of that is attacker-controlled.
#   1 (default) — one proxy, e.g. Caddy terminating TLS in front of :3005
#   2           — two, e.g. Cloudflare -> Caddy -> app
#   0           — app is NOT behind a proxy; forwarding headers are ignored and
#                 per-IP limits are skipped (per-account limits still apply)
# Too HIGH fails closed (per-IP limiting skipped); too LOW re-opens spoofing.
# WBOS_TRUSTED_PROXY_HOPS="1"
#
# Trust X-Real-IP when X-Forwarded-For is absent. Only enable if the proxy
# OVERWRITES it (nginx `proxy_set_header X-Real-IP $remote_addr`); it carries no
# hop information and is forgeable otherwise.
# WBOS_TRUST_X_REAL_IP="0"

# Internal URL for server-side rendering (Playwright PDF generation uses this)
# In Docker, set to http://127.0.0.1:3000 so Playwright can reach the app
INTERNAL_APP_URL="http://127.0.0.1:3000"

# PostgreSQL password (used by docker-compose to set up the database)
POSTGRES_PASSWORD="changeme"

# Host port to bind the application to (default: 3000)
PORT=3000

# Storage root for uploaded files (default: ./storage)
WBOS_STORAGE_ROOT="./storage"

# ── First owner / bootstrap (production Day-0) ──────────────────────────────
#
# Email of the account that owns the bootstrap organization. Set this BEFORE
# anyone signs up so Day-0 ownership is a deliberate choice rather than a race
# to sign up first.
#
# It is used in two places:
#   * prisma/seed.mjs — attaches that user as OWNER; safe to re-run at any time
#     to repair a missing membership (it reconciles even if the org exists).
#   * onboarding — lets that email claim OWNER of an organization that already
#     has members. Any OTHER new signup is refused, because sign-up is public
#     and auto-attaching would hand OWNER to anyone who found the URL.
#
# Leave unset in development: with exactly one user the seed attaches them
# unambiguously, and the first user through onboarding claims an empty org.
# WBOS_BOOTSTRAP_OWNER_EMAIL="owner@yourdomain.com"

# ── SMTP / password recovery (optional but recommended) ─────────────────────
#
# WBOS_SMTP_HOST is the switch. Leave it UNSET and password recovery is simply
# off: the app runs normally and /forgot-password says recovery is unavailable
# instead of pretending to send mail.
#
# Once WBOS_SMTP_HOST is set, the rest must be complete — startup validation
# FAILS on a half-configured mailer, because that failure would otherwise only
# surface when someone is already locked out.
#
# Without this, a forgotten owner password is an unrecoverable lockout: there is
# no other reset path.
#
# Plain SMTP via Nodemailer — no provider-specific code, so any service works.
# WBOS_SMTP_HOST="smtp.example.com"
# WBOS_SMTP_PORT="587"              # 587 = STARTTLS (default), 465 = implicit TLS
# WBOS_SMTP_SECURE="0"              # defaults to true only on port 465
# WBOS_SMTP_FROM="WBOS <no-reply@yourdomain.com>"   # required when enabled
#
# Auth is optional (an internal relay may not need it), but user and password
# must be set together.
# WBOS_SMTP_USER="apikey"
# WBOS_SMTP_PASSWORD="..."          # NEVER commit — inject from the secret store
#
# Production provider (Resend) — same four variables, nothing special in code:
#   WBOS_SMTP_HOST="smtp.resend.com"
#   WBOS_SMTP_PORT="465"
#   WBOS_SMTP_USER="resend"                 # literally "resend"
#   WBOS_SMTP_PASSWORD="re_..."             # API key, from the secret store
#   WBOS_SMTP_FROM="WBOS <no-reply@yourdomain.com>"   # domain must be verified in Resend
#
# Only disable certificate verification for a local test relay (e.g. Mailpit).
# WBOS_SMTP_REJECT_UNAUTHORIZED="1"
#
# Reset-link lifetime in seconds (default 3600 = 1 hour). The email states this
# same number, and the token is single-use.
# WBOS_RESET_TOKEN_TTL_SECONDS="3600"
#
# Verify before go-live (connects, authenticates, optionally sends):
#   docker compose -f docker-compose.prod.yml exec -T app \
#     node scripts/smtp-check.mjs you@example.com

# ── Push Notifications (optional) ───────────────────────────────────────────
#
# Firebase Admin SDK credentials for FCM push notifications.
# Required for real-time push delivery to mobile devices.
# If not set, notifications work via in-app polling only.
#
# FIREBASE_ADMIN_PROJECT_ID="your-firebase-project-id"
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Alternative: path to Firebase service account JSON file (gitignored, store in .secrets/)
# FIREBASE_ADMIN_KEY_PATH="./.secrets/firebase-service-account.json"

# ── Backup (optional overrides) ─────────────────────────────────────────────

# WBOS_BACKUP_DIR="./backups"
#
# Backup directory layout (<backup-root>/*):
#   daily/   — last 7 kept (created every run)
#   weekly/  — last 4 kept (promoted every Sunday)
#   monthly/ — last 12 kept (promoted on 1st of month)
#   yearly/  — kept forever (promoted on Dec 31)
#   uploads/ — last 7 kept (auto-backup of storage when WBOS_STORAGE_ROOT is set)
#
# The Backup & Restore settings page stores single-file packages in:
#   <WBOS_BACKUP_DIR>/packages/wbos-backup-<timestamp>.tar.gz
# WBOS_APP_VERSION="0.1.0"
#
# Minimum free bytes the storage filesystem must keep. Attachments and logo
# uploads are REJECTED when a write would leave less than this free, so
# attachment growth cannot silently fill the host disk. Default 512 MB
# (536870912).
# WBOS_STORAGE_MIN_FREE_BYTES="536870912"

# ── Off-Host Backup Sync (production) ───────────────────────────────────────

# Destination URI for scripts/sync-backups.sh (run on host cron).
#   rsync://user@nas.local:/volume1/wbos-backups   — NAS via rsync/SSH (recommended)
#   s3://wbos-backups/prod                         — S3-compatible via rclone
#   file:///mnt/backup                             — local second disk/mount
# WBOS_BACKUP_SYNC_TARGET="rsync://user@nas.local:/volume1/wbos-backups"
#
# Extra args passed to rsync/rclone (e.g. bandwidth caps, exclude filters).
# WBOS_BACKUP_SYNC_EXTRA="--bwlimit=2000"

# ── Alerting (production) ───────────────────────────────────────────────────
#
# scripts/health-alert.sh (run on host cron) polls the existing /api/health
# endpoint and notifies on: app unreachable, DB down, disk low, storage not
# writable, backup stale (>WBOS_ALERT_BACKUP_STALE_HOURS), backup tools broken.
# At least ONE notification channel must be configured (webhook, Telegram,
# ntfy, or email), otherwise it runs in log-only mode.
#
# WBOS_ALERT_HEALTH_URL="http://127.0.0.1:3005/api/health"   # published app port
# WBOS_ALERT_BACKUP_STALE_HOURS="48"
# WBOS_ALERT_DISK_THRESHOLD="10"       # alert below this available-disk %
# WBOS_ALERT_UPLOADS_WARN_PCT="60"     # alert when uploads use this % of the storage disk
# WBOS_ALERT_UPLOADS_CRITICAL_PCT="75" # critical alert level for uploads size
# WBOS_ALERT_COOLDOWN_HOURS="6"        # re-alert interval while a condition persists
# WBOS_ALERT_RECOVERY="1"              # 1 = send a notice when a condition clears
# WBOS_ALERT_ALERT_ON_NO_RESTORE_TEST="0"  # 1 = also alert if no restore test on record
#
# Generic JSON webhook (Slack/Teams/any bot): POSTs {"text": "..."}
# WBOS_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# Telegram bot (curl to api.telegram.org):
# WBOS_ALERT_TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# WBOS_ALERT_TELEGRAM_CHAT_ID="123456789"
# ntfy push (default server https://ntfy.sh):
# WBOS_ALERT_NTFY_URL="https://ntfy.sh"
# WBOS_ALERT_NTFY_TOPIC="wbos-alerts"
# Email (best-effort; requires a local `mail`/MTA on the host):
# WBOS_ALERT_EMAIL_TO="ops@example.com"

# ── PostgreSQL (production `db` service on the VPS) ─────────────────────────
#
# Credentials for the db service in docker-compose.prod.yml. These MUST match
# the user/password/database in DATABASE_URL above.
#
# The service publishes NO port: it is reachable only from other containers on
# the wbos-prod network, so PostgreSQL is never exposed to the internet. Use
# `docker compose -f docker-compose.prod.yml exec db psql -U wbos wbos` for
# operator access.
# POSTGRES_USER="wbos"
# POSTGRES_PASSWORD="change-me-to-a-strong-password"
# POSTGRES_DB="wbos"
#
# PostgreSQL image. Major version 17 is standard across production, CI, and
# restore testing, and matches postgresql-client-17 in the app image. pg_dump
# refuses to dump from a NEWER server and pg_restore cannot reliably load into
# an OLDER one, so a split silently breaks disaster recovery.
# ⚠ Changing the major on an existing deployment needs a data migration —
# see docs/PRODUCTION_DEPLOYMENT.md §12.
# POSTGRES_IMAGE="postgres:17-alpine"
#
# Seconds the container waits for the database before exiting (the restart
# policy then retries). Covers a slow database start after a VPS reboot.
# WBOS_DB_WAIT_SECONDS="90"

# ── Deploy (production) ─────────────────────────────────────────────────────
#
# GHCR image tag deployed by scripts/deploy.sh / docker-compose.prod.yml.
# Defaults to `latest`. Pin to a commit SHA to redeploy or roll back:
#   WBOS_IMAGE_TAG="a6bbf24..."
# WBOS_IMAGE_TAG="latest"

# ── Health (optional) ───────────────────────────────────────────────────────
#
# Hours after which an EXISTING backup is considered stale by /api/health.
# A stale backup makes the app report unhealthy; having no backup at all
# (a fresh Day-0 deployment) does NOT — it is reported and alerted on instead,
# so the first deploy is not blocked by a healthcheck it cannot yet satisfy.
# Keep aligned with WBOS_ALERT_BACKUP_STALE_HOURS above.
# WBOS_HEALTH_BACKUP_STALE_HOURS="48"
